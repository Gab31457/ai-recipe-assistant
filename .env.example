# PostgreSQL database password used by Docker Compose.
# Copy this file to .env and replace the example values.
POSTGRES_PASSWORD=replace_with_a_strong_local_password

# PostgreSQL connection string used by the Next.js backend.
DATABASE_URL=postgresql://recipe_user:replace_with_a_strong_local_password@localhost:5432/recipe_assistant

# OpenAI model used for generating the final RAG answer
OPENAI_CHAT_MODEL=gpt-4o-mini

# Activate system prompt variant:
# strict or conversational
SYSTEM_PROMPT_VARIANT=strict